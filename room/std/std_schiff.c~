#include "def.h"

inherit REGION_ROOM "std/std_raum";

public int cant_open_door() {
  write(break_string("Das ist eine automatische Tuer! Sie oeffnet sich, "
        "sobald du sie durschreiten willst!"));

  return 1;
}

public void close_sound() {
  tell_room(ME,"Die automatische Tuer schliesst sich wieder mit "
               "einem '"+SND_DOOR+"'.\n");
   
}

public int door_sound() {
  write("\n"+break_string("Die automatische Tuer oeffnet sich mit "
        "einem '"+SND_DOOR+"' und du gehst hindurch. Hinter dir schliesst sie "
        "sich wieder.")+"\n");
  
  tell_room(ME,break_string("Die automaische Tuer oeffnet sich mit einem "
               "'"+SND_DOOR+"'."),({PL}));
  
  call_out("close_sound",0);
  return 0;
} 

protected void create() {
  ::create();
  SetProp(P_TERRAIN,T_CONSTRUCT);
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_INT_SHORT,"Im Raumschiff Proton");
  SetProp(P_INT_LONG, "Im Raumschiff Proton.");
  AddDetail(({"schiff","raumschiff","proton"}),#'_query_int_long);
}
